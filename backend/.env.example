# Copy to `.env` (never commit `.env`) and adjust for your machine.
# All values below are placeholders.

# PostgreSQL connection (required).
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/decision_regret

# FastAPI ML service (see ml/README.md). Required for prediction requests.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=5000

# Express server.
PORT=3001
PG_POOL_MAX=10

# Allowed browser origins (comma separated). The Vite dev server defaults:
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# No authentication exists yet. Do not expose this service publicly.
NODE_ENV=development
