# Frontend environment (Vite). Copy to `.env` or `.env.local` and adjust.
# Only VITE_-prefixed variables are exposed to the browser — never put
# secrets here. Real `.env` files are git-ignored; only this example is
# tracked.

# Base URL of the Express backend used by src/lib/api.js.
# Default when this variable is unset: http://localhost:3001
# Set it to an empty value (VITE_API_BASE_URL=) to make requests relative to
# the page's own origin — useful when a dev-server proxy forwards them
# (see PROXY_TARGET in vite.config.js and the root README).
VITE_API_BASE_URL=http://localhost:3001
